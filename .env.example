# Client-safe Supabase configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-public-anon-key

# Server-only Supabase configuration
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Cashfree Payments (server-only)
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-server-only-cashfree-secret
CASHFREE_WEBHOOK_SECRET=your-server-only-cashfree-webhook-secret
CASHFREE_ENVIRONMENT=sandbox
